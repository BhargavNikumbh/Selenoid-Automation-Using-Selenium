<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="OrangeHRM Test Suite">

    <listeners>
        <listener
                class-name="org.orangehrm.listeners.ExtentReportListener" />

        <listener
                class-name="org.orangehrm.listeners.AnnotationTransformer" />
    </listeners>


    <test name="Login Test">
        <parameter name="browser" value="chrome" />
        <parameter name="browserversion" value="152.0" />
        <classes>
            <class name="com.tests.orangehrm.tests.LoginTests"/>
        </classes>

    </test>

</suite>
